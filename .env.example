# DataHub Configuration
DATAHUB_GMS_URL=http://localhost:8085
DATAHUB_FRONTEND_URL=http://localhost:9002

# PostgreSQL Configuration
# NOTE: docker-compose.yml maps host port 5433 → container port 5432
# Use 5433 when connecting from the host machine (outside Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=paysim_fintech
POSTGRES_USER=paysim_user
POSTGRES_PASSWORD=paysim_secret_2026

# Agent Configuration
AGENT_LOG_LEVEL=INFO

# Multi-Agent LLM (REQUIRED for the Multi-Agent Team tab)
# The 5-agent team (Detector → RootCauseAnalyst → ImpactAssessor ‖ FixAuthor
# → Reviewer) is orchestrated by LangGraph. Every agent's reasoning and the
# Reviewer's verdict come from the LLM — without a key the team refuses to
# run. Tools (schema scans, lineage, SQL validation) still execute in code.
#
# Provider priority: whichever key is set first (OPENAI first). Set
# LLM_PROVIDER to force one explicitly (openai | anthropic | none).
#
# OpenAI (default when OPENAI_API_KEY is set):
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
#
# Using an OpenAI-compatible gateway instead of api.openai.com directly
# (SumoPod, Azure-style proxies, self-hosted vLLM/Ollama, etc.) — set the
# base URL or the SDK will 401/404 against the wrong host. Verified working
# with SumoPod (https://sumopod.com) — note the /v1 suffix is required:
# OPENAI_BASE_URL=https://ai.sumopod.com/v1
# OPENAI_MODEL=gpt-4o-mini
#
# Anthropic (fallback / alternative):
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
#
# Force provider (optional):
# LLM_PROVIDER=openai
